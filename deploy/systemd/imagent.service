[Unit]
Description=imagent — IM ↔ agent gateway
Documentation=https://github.com/uzziah/imagent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按实际安装路径调整：
ExecStart=/usr/local/bin/imagent start
# 必须改成实际运行用户（服务以该用户身份运行，需对其 ~/.imagent 有读写权）。
# 取消注释并替换为你的用户名；原 `User=%i` 仅对模板单元(imagent@.service)有效，
# 本文件为非模板单元，%i 展开为空会触发 "User may not be empty" 启动失败（B5）。
# User=imagent
# Environment=RUST_LOG=info
# Environment=IMAGENT_CONFIG=/home/imagent/.imagent/config.toml
Restart=on-failure
RestartSec=5
# 安全加固（建议放开）：
NoNewPrivileges=true
ProtectSystem=strict
# ⚠️ 必须把 config.toml 的 default_workdir 也加进 ReadWritePaths，否则 ProtectSystem=strict
#    会让 agent 写 workdir 被静默拒绝（首装必踩）。例如 default_workdir=/srv/agent-ws：
# ReadWritePaths=%h/.imagent /srv/agent-ws
ReadWritePaths=%h/.imagent

[Install]
WantedBy=multi-user.target
